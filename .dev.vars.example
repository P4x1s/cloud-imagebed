# 本地开发用的 Secret 模板，复制为 .dev.vars 后填入真实值。
# .dev.vars 已被 .gitignore 忽略，不会被提交。
# 本地运行：wrangler dev

# GitHub Personal Access Token (classic)：勾选 repo（私有仓库）或 public_repo（公开仓库）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 前端登录口令（自定义一个强口令）
ACCESS_PASSWORD=change-me-to-a-strong-password

# Cloudflare Turnstile 人机校验（可选，两项都填才启用；不填则自动跳过验证）
# 站点密钥（公开，前端渲染用）：到 Cloudflare Dashboard → Turnstile 创建后复制
TURNSTILE_SITE_KEY=
# 密钥（保密，服务端 siteverify 用，切勿提交）
TURNSTILE_SECRET_KEY=
